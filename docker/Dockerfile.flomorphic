# syntax=docker/dockerfile:1
#
# Baked image for the FloMorphic stack: morph-api + morph-wapp + the builtin
# plugin nodes, all compiled at image-build time and served behind one nginx.
#
# Why bake everything: the api (cgo: sqlite + sqlite-vec) and the canvas (pnpm
# build) are heavy, and the plugin nodes — though small pure-Go binaries — used to
# be cloned and compiled by the entrypoint at first container start, which put a
# github + Go-proxy round-trip on the boot path and made a bad first-start
# experience on networks where either is slow or blocked. Building them into the
# image instead makes startup near-instant and needs no toolchain or network to
# run. Every plugin folder is compiled here, so the binaries are naturally
# multi-arch: buildx builds this stage FOR the target platform (natively or under
# QEMU), so `go build` emits an amd64 binary for linux/amd64 and an arm64 binary
# for linux/arm64 with no cross-compile flags.
#
# This is the only image FloMorphic ships. It is what `install.sh` pulls, what
# `make build` produces locally, and what CI publishes per-arch. To build from
# source, clone this repo and `make build` (or `make release` to publish).
#
# Build (context is this repo — it supplies docker/entrypoint.sh + nginx.conf).
# The Makefile drives it:
#   make build                         # host arch, as flomorphic:local
#   make release                       # multi-arch :$(git describe) + :latest
# By hand:
#   docker build -f docker/Dockerfile.flomorphic -t flomorphic:local .
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f docker/Dockerfile.flomorphic -t mehdishokohi/flomorphic:latest --push .
#
# Pin what goes in with --build-arg API_REF=v0.2.0 (etc).

ARG API_REPO=https://github.com/FloMorphic/morph-api.git
ARG API_REF=main
ARG WAPP_REPO=https://github.com/FloMorphic/morph-wapp.git
ARG WAPP_REF=main
ARG PLUGINS_REPO=https://github.com/FloMorphic/builtin-plugins.git
ARG PLUGINS_REF=main
# The version string shown in the canvas UI. Named for the product image, so the
# Makefile passes its VERSION here; empty leaves the app's own 'dev' fallback.
ARG APP_VERSION=

# Go module proxy, overridable because the default CDN is not reachable
# everywhere: proxy.golang.org redirects module zips to storage.googleapis.com,
# and networks that block it answer 403 mid-download. Point it at a mirror then:
#   docker build --build-arg GOPROXY=https://goproxy.cn,direct …
ARG GOPROXY="https://proxy.golang.org,direct"

# ── the API (cgo: sqlite + sqlite-vec) ────────────────────────────────────────
FROM golang:1.26-alpine AS api-build
ARG API_REPO
ARG API_REF
ARG GOPROXY
# sqlite-vec's amalgamation contains, for every non-Windows/wasm target:
#   typedef u_int8_t uint8_t;  (and u_int16_t / u_int64_t)
# `u_int*_t` is a BSD/glibc spelling that musl does not define, so on Alpine the
# typedefs collapse to implicit int and the file fails to compile. Mapping them
# to the C99 names makes those lines legal self-typedefs; on glibc it is a no-op.
ARG MUSL_CFLAGS="-Du_int8_t=uint8_t -Du_int16_t=uint16_t -Du_int64_t=uint64_t"
RUN apk add --no-cache git make build-base
# The version tag on getting-started names the IMAGE; the component repos are
# tracked at their default branch and are not expected to carry a matching tag.
# That branch is `main` in one repo and `master` in the next, so a ref the remote
# does not have falls back to its HEAD rather than failing the build. Same for the
# canvas and plugin clones below.
RUN git clone --depth 1 -b "$API_REF" "$API_REPO" /src/api \
 || { rm -rf /src/api; git clone --depth 1 "$API_REPO" /src/api; }
WORKDIR /src/api
# Through the Makefile: it owns the cgo flags for the vendored sqlite header.
# Passing CGO_CFLAGS here overrides that assignment, so the include is restated.
RUN make build BINARY=/out/flomorphic-api \
      CGO_CFLAGS="-I/src/api/repository/sqlite/cdeps $MUSL_CFLAGS"

# ── the builtin plugin nodes ──────────────────────────────────────────────────
#
# One repo of small pure-Go binaries (CGO off), one folder per node. This stage
# is built for the TARGET platform, so `go build` produces target-arch binaries
# with no GOARCH juggling — amd64 natively on an amd64 builder, arm64 under QEMU
# (or natively on an arm64 builder). Every folder with a go.mod is compiled and
# dropped into /out/plugins/<folder>.
FROM golang:1.26-alpine AS plugins-build
ARG PLUGINS_REPO
ARG PLUGINS_REF
ARG GOPROXY
RUN apk add --no-cache git
RUN git clone --depth 1 -b "$PLUGINS_REF" "$PLUGINS_REPO" /src/plugins \
 || { rm -rf /src/plugins; git clone --depth 1 "$PLUGINS_REPO" /src/plugins; }
WORKDIR /src/plugins
RUN set -eu; mkdir -p /out/plugins; \
    for d in */; do \
      [ -f "${d}go.mod" ] || continue; \
      name="${d%/}"; \
      echo "building plugin $name"; \
      ( cd "$d" && CGO_ENABLED=0 go build -trimpath -o "/out/plugins/$name" . ); \
    done

# ── the canvas ────────────────────────────────────────────────────────────────
FROM node:22-alpine AS wapp-build
ARG WAPP_REPO
ARG WAPP_REF
ARG APP_VERSION
# Relative base: every API call is same-origin and nginx routes it, so this build
# is not tied to any host name. See docker/nginx.conf.tmpl.
ARG VITE_API_BASE_URL=/api
RUN apk add --no-cache git && npm install -g pnpm@10
RUN git clone --depth 1 -b "$WAPP_REF" "$WAPP_REPO" /src/wapp \
 || { rm -rf /src/wapp; git clone --depth 1 "$WAPP_REPO" /src/wapp; }
WORKDIR /src/wapp
RUN pnpm install --frozen-lockfile
RUN VITE_API_BASE_URL="$VITE_API_BASE_URL" VITE_APP_VERSION="$APP_VERSION" pnpm build

# ── runtime ───────────────────────────────────────────────────────────────────
#
# Everything is baked, so no toolchain and no git here — just what the entrypoint
# needs to serve and supervise: nginx, plus curl/jq/openssl for the API health
# check and the plugin-credential mint.
FROM alpine:3.21
RUN apk add --no-cache nginx curl jq openssl ca-certificates tzdata

COPY --from=api-build     /out/flomorphic-api /app/flomorphic-api
COPY --from=wapp-build    /src/wapp/dist      /srv/www
COPY --from=plugins-build /out/plugins        /app/plugins
# The seed is the source of truth for the builtin nodes' PLUGIN_IDs; keep a copy
# so the entrypoint can resolve them even if the API is not answering yet.
COPY --from=api-build     /src/api/repository/sqlite/seed/builtins.json /app/seed/builtins.json

COPY docker/nginx.conf.tmpl /etc/nginx/nginx.conf.tmpl
COPY docker/entrypoint.sh   /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && mkdir -p /data

ENV PLUGINS_ENABLED=1 \
    APP_DIR=/app \
    WEB_ROOT=/srv/www \
    PORT=8025 \
    WEB_PORT=80 \
    DB_SOURCE=/data/flomorphic.db

VOLUME ["/data"]
EXPOSE 80 8025

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
