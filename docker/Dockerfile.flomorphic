# syntax=docker/dockerfile:1
#
# Baked image for the whole FloMorphic stack: morph-api + morph-wapp + the
# builtin plugin nodes, compiled at image-build time and served behind one nginx.
#
# Same runtime contract as Dockerfile.flomorphic-src (identical entrypoint, same
# env vars, same ports) — the only difference is WHEN things compile. Here the
# sources are cloned and built in the stages below, so the container starts in
# seconds; there, everything is built at container start, so one image serves
# every architecture. This one is what `install.sh --build` produces locally and
# what CI should publish per-arch.
#
# Build (context is this repo — it supplies docker/entrypoint.sh + nginx.conf).
# The Makefile drives both, and publishes this one on the -baked tags:
#   make build-baked                   # host arch, as flomorphic:local-baked
#   make release-baked                 # :$(git describe)-baked + :baked
# By hand:
#   docker build -f docker/Dockerfile.flomorphic -t flomorphic:local .
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f docker/Dockerfile.flomorphic -t mehdishokohi/flomorphic:latest --push .
#
# Pin what goes in with --build-arg API_REF=v0.2.0 (etc).

ARG API_REPO=https://github.com/FloMorphic/morph-api.git
ARG API_REF=main
ARG WAPP_REPO=https://github.com/FloMorphic/morph-wapp.git
ARG WAPP_REF=main
ARG PLUGINS_REPO=https://github.com/FloMorphic/builtin-plugins.git
ARG PLUGINS_REF=main

# Go module proxy, overridable because the default CDN is not reachable
# everywhere: proxy.golang.org redirects module zips to storage.googleapis.com,
# and networks that block it answer 403 mid-download. Point it at a mirror then:
#   docker build --build-arg GOPROXY=https://goproxy.cn,direct …
ARG GOPROXY="https://proxy.golang.org,direct"

# ── the API (cgo: sqlite + sqlite-vec) ────────────────────────────────────────
FROM golang:1.26-alpine AS api-build
ARG API_REPO
ARG API_REF
ARG GOPROXY
# sqlite-vec's amalgamation contains, for every non-Windows/wasm target:
#   typedef u_int8_t uint8_t;  (and u_int16_t / u_int64_t)
# `u_int*_t` is a BSD/glibc spelling that musl does not define, so on Alpine the
# typedefs collapse to implicit int and the file fails to compile. Mapping them
# to the C99 names makes those lines legal self-typedefs; on glibc it is a no-op.
ARG MUSL_CFLAGS="-Du_int8_t=uint8_t -Du_int16_t=uint16_t -Du_int64_t=uint64_t"
RUN apk add --no-cache git make build-base
RUN git clone --depth 1 -b "$API_REF" "$API_REPO" /src/api
WORKDIR /src/api
# Through the Makefile: it owns the cgo flags for the vendored sqlite header.
# Passing CGO_CFLAGS here overrides that assignment, so the include is restated.
RUN make build BINARY=/out/flomorphic-api \
      CGO_CFLAGS="-I/src/api/repository/sqlite/cdeps $MUSL_CFLAGS"

# ── the builtin plugin nodes (pure Go, one binary per folder) ─────────────────
FROM golang:1.26-alpine AS plugins-build
ARG PLUGINS_REPO
ARG PLUGINS_REF
ARG GOPROXY
RUN apk add --no-cache git
RUN git clone --depth 1 -b "$PLUGINS_REF" "$PLUGINS_REPO" /src/plugins
# Every top-level folder with a go.mod is a plugin binary — so a plugin added to
# the repo is picked up here with no change to this file.
RUN mkdir -p /out/bin && cd /src/plugins && \
    for d in */; do \
      [ -f "$d/go.mod" ] || continue; \
      n="${d%/}"; \
      echo "building plugin $n"; \
      ( cd "$d" && CGO_ENABLED=0 go build -trimpath -o "/out/bin/$n" . ); \
    done && \
    printf '%s@%s' "$PLUGINS_REPO" "$PLUGINS_REF" > /out/bin/.ref

# ── the canvas ────────────────────────────────────────────────────────────────
FROM node:22-alpine AS wapp-build
ARG WAPP_REPO
ARG WAPP_REF
# Relative base: every API call is same-origin and nginx routes it, so this build
# is not tied to any host name. See docker/nginx.conf.tmpl.
ARG VITE_API_BASE_URL=/api
RUN apk add --no-cache git && npm install -g pnpm@10
RUN git clone --depth 1 -b "$WAPP_REF" "$WAPP_REPO" /src/wapp
WORKDIR /src/wapp
RUN pnpm install --frozen-lockfile
RUN VITE_API_BASE_URL="$VITE_API_BASE_URL" pnpm build

# ── runtime ───────────────────────────────────────────────────────────────────
#
# Still a Go image, deliberately: PLUGINS_REPO/PLUGINS_REF can be pointed at
# another repo or ref at run time, and the entrypoint then rebuilds the plugin
# binaries in place. Without a toolchain that extension point would be gone.
FROM golang:1.26-alpine
RUN apk add --no-cache git nginx curl jq openssl ca-certificates tzdata

COPY --from=api-build     /out/flomorphic-api /app/flomorphic-api
COPY --from=plugins-build /out/bin            /app/plugins
COPY --from=wapp-build    /src/wapp/dist      /srv/www
# The seed is the source of truth for the builtin nodes' PLUGIN_IDs; keep a copy
# so the entrypoint can resolve them even if the API is not answering yet.
COPY --from=api-build     /src/api/repository/sqlite/seed /src/api/repository/sqlite/seed

COPY docker/nginx.conf.tmpl /etc/nginx/nginx.conf.tmpl
COPY docker/entrypoint.sh   /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && mkdir -p /data /src

ARG PLUGINS_REPO
ARG PLUGINS_REF
ARG GOPROXY
# Carried into the container so a runtime plugin rebuild (a changed PLUGINS_REF)
# uses the same reachable proxy the image was built with.
ENV GOPROXY=${GOPROXY} \
    FLOMORPHIC_PREBUILT=1 \
    PLUGINS_REPO=${PLUGINS_REPO} \
    PLUGINS_REF=${PLUGINS_REF} \
    PLUGINS_ENABLED=1 \
    SRC_DIR=/src \
    APP_DIR=/app \
    WEB_ROOT=/srv/www \
    PORT=8025 \
    WEB_PORT=80 \
    DB_SOURCE=/data/flomorphic.db

VOLUME ["/data"]
EXPOSE 80 8025

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
