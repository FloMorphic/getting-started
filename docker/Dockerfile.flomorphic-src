# syntax=docker/dockerfile:1
#
# Self-building RUNTIME image for the whole FloMorphic stack.
#
# This image ships only tooling — Go, Node, nginx, git — and compiles NOTHING at
# `docker build` time. At container START the entrypoint clones morph-api and
# morph-wapp (at $API_REF / $WAPP_REF), builds both native to the CPU it is
# running on, then brings up nginx + the API + the builtin plugin nodes. That is
# why one published manifest works on amd64 and arm64 with no cross-compiling:
# the compile happens on the target machine, at run time.
#
# It is the same trick the inflow-inspector images use, with two additions the
# FloMorphic stack needs:
#   - the API is cgo (sqlite + sqlite-vec), so build-base + make are installed;
#   - the plugin nodes are cloned and built at run time too, because they need a
#     credential that only the running API can mint (see entrypoint.sh).
#
# Trade-off: the first start takes a few minutes and needs network (GitHub, Go
# modules, npm). Persist /src on a volume — the checkout, the Go module cache and
# the pnpm store live there, so restarts are quick. Want a fast first start
# instead? Build Dockerfile.flomorphic, which bakes all of it at image time.
#
# This is the channel published as :latest — see the Makefile, which builds it
# per arch and merges the manifests:
#   make release                       # :$(git describe) + :latest
#   make build                         # host arch only, as flomorphic:local
# By hand, from a clone of this repo (the context supplies ./docker):
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f docker/Dockerfile.flomorphic-src \
#     -t mehdishokohi/flomorphic:latest --push .

FROM golang:1.26-alpine

# git            fetch the sources at container start
# make/build-base cgo toolchain for sqlite + sqlite-vec (the API's Makefile)
# nodejs/npm     build the canvas; pnpm is the canvas's package manager
# nginx          serve the SPA and proxy /api + /ws to the API
# curl/jq        health probe + credential minting against the local API
# openssl        HS256 bearer when AUTH_ENABLED is turned on
RUN apk add --no-cache \
        git make build-base nodejs npm nginx curl jq openssl ca-certificates \
 && npm install -g pnpm@10 \
 && npm cache clean --force

# Go module proxy. Overridable because the default CDN is not reachable
# everywhere: proxy.golang.org redirects module zips to storage.googleapis.com,
# and networks that block it answer 403 mid-download. A mirror fixes it —
# `docker run -e GOPROXY=https://goproxy.cn,direct …`, or GOPROXY in
# flomorphic/.env. This image compiles at container START, so the value has to
# be settable at run time, not only at build time.
ARG GOPROXY="https://proxy.golang.org,direct"

# What this image clones and compiles at container start. They stay ENV, so
# `docker run -e API_REF=…` (or the compose file) still wins at run time — the
# ARGs only set the DEFAULT baked into a given image, which is what makes a
# published :vX.Y.Z tag mean something: without them every version of this
# self-building image would compile `main` whenever it happened to start.
ARG API_REPO=https://github.com/FloMorphic/morph-api.git
ARG API_REF=main
ARG WAPP_REPO=https://github.com/FloMorphic/morph-wapp.git
ARG WAPP_REF=main
ARG PLUGINS_REPO=https://github.com/FloMorphic/builtin-plugins.git
ARG PLUGINS_REF=main

# GOMODCACHE/GOCACHE point at /src so the module cache and build cache land on
# the same persisted volume as the checkout — that is what makes restarts quick.
ENV GOPROXY=${GOPROXY} \
    API_REPO=${API_REPO} \
    API_REF=${API_REF} \
    WAPP_REPO=${WAPP_REPO} \
    WAPP_REF=${WAPP_REF} \
    PLUGINS_REPO=${PLUGINS_REPO} \
    PLUGINS_REF=${PLUGINS_REF} \
    PLUGINS_ENABLED=1 \
    SRC_DIR=/src \
    APP_DIR=/app \
    WEB_ROOT=/srv/www \
    PORT=8025 \
    WEB_PORT=80 \
    VITE_API_BASE_URL=/api \
    DB_SOURCE=/data/flomorphic.db \
    FLOMORPHIC_PREBUILT=0 \
    GOMODCACHE=/src/.gomodcache \
    GOCACHE=/src/.gocache

COPY docker/nginx.conf.tmpl /etc/nginx/nginx.conf.tmpl
COPY docker/entrypoint.sh   /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && mkdir -p /src /app /data /srv/www

VOLUME ["/data"]
EXPOSE 80 8025

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
