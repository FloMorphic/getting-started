+
+// commitDoc queues a document write and waits until it has been APPLIED, not
+// merely received. Without the wait, a node settled and had its successors
+// queued while its own result was still in flight, and a successor that read
+// the document in that window saw the value as absent.
+//
+// The ctx cases are the escape: a process that is finishing or cancelled closes
+// the write queue and stops its handler, and a task parked here must not outlive
+// it.
+func (t *Task) commitDoc(req updateDocRequest) {
+	req.applied = make(chan struct{})
+	// A Process built without a ctx (tests do) never cancels: a nil channel in a
+	// select simply never fires, which is exactly that meaning.
+	var cancelled <-chan struct{}
+	if t.Proc.ctx != nil {
+		cancelled = t.Proc.ctx.Done()
+	}
+	select {
+	case t.Proc.writeQueueChan <- req:
+	case <-cancelled:
+		return
+	}
+	select {
+	case <-req.applied:
+	case <-cancelled:
+	}
 }
 
