+// applyDocWrite applies one queued write to docContext and then acknowledges it.
+//
+// Every return path acknowledges — applied, re-pointed to $.unknow, or failed —
+// because the sender is parked on req.applied until this returns, and a write
+// that could never be acked would hang the task that made it. The ack is the
+// whole point: see updateDocRequest.applied.
+func (p *Process) applyDocWrite(req updateDocRequest) {
+	defer func() {
+		if req.applied != nil {
+			close(req.applied)
+		}
+	}()
+	// A write AT the root merges its fields instead of replacing the document —
+	// the key-less node that contributes fields to a shared record.
+	if req.loc.String() == jp.R().String() {
+		if nval, ok := req.value.(gen.Object); ok {
+			p.l.Lock()
+			maps.Copy(p.docContext.(gen.Object), nval)
+			p.l.Unlock()
+			return
+		}
+		// A non-object result has nowhere to merge into.
+		req.loc, _ = jp.ParseString("$.unknow")
+	}
+	p.l.Lock()
+	err := req.loc.Set(p.docContext, req.value)
+	p.l.Unlock()
+	if err != nil {
+		// @TODO - log error
+		logtool.GetLogger().Error("error updating doc context", "process", p.req.PID, "error", err.Error())
+		fmt.Printf("error updating doc context: %v\n", err)
+	}
+}
