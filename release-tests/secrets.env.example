# Real secret values for release-tests profiles. NOT committed (see .gitignore).
# Regenerate with: ./flotest pull --profiles  (or copy from your dev install).

LLM_DEAD_ENDPOINT_ACCESS_TOKEN=
NARA_AI_ACCESS_TOKEN=

# Per-install overrides (not secrets). A containerised instance reaches the
# host through host.docker.internal, which is the default baked into the
# profile; set this only if your Ollama is somewhere else, e.g.
# http://localhost:11434 when the API runs on the host rather than in Docker.
# OLLAMA_URL=
