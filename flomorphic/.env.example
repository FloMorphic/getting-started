# FloMorphic stack — copy to `.env` and adjust. install.sh writes this for you.

# ─── Platform ────────────────────────────────────────────────────────────────

# Infra's REST API. On the shared `inflow_net` network the container name is the
# host; point it elsewhere for a platform on another machine.
# Leave EMPTY to run the canvas + API standalone (design and save workflows with
# browser-independent storage, but no Run and no plugin nodes).
INFLOW_INFRA_API=http://inflow-infra:8022

# Infra's API Secret Key — the value Infra prints on first boot ("API Secret Key
# is : ..."), or whatever you set as API_JWT_SECRET in the platform's .env.
# flomorphic-api authenticates to Infra with it, so it MUST match.
INFLOW_INFRA_JWT_SECRET=

# ─── This API ────────────────────────────────────────────────────────────────

# Guard the CRUD routes with an HS256 bearer token. Off by default so the canvas
# works with no sign-in; the log WebSocket stays open either way.
AUTH_ENABLED=false
# Secret for this API's own tokens. Falls back to INFLOW_INFRA_JWT_SECRET.
API_JWT_SECRET=

# SQLite file inside the container (./data is mounted there).
DB_SOURCE=/data/flomorphic.db

# ─── Published ports ─────────────────────────────────────────────────────────

# The canvas — open this in a browser. Everything else is proxied behind it.
FLOMORPHIC_PORT=8088
# The API, published for tooling. 8026 by default so it does not collide with
# inflow-inspector-api on 8025.
FLOMORPHIC_API_PORT=8026

# ─── Image ───────────────────────────────────────────────────────────────────

# The published image is baked: api + canvas are compiled in, so it starts in
# seconds. `install.sh --build` / `make build` set this to a local tag instead.
FLOMORPHIC_IMAGE=mehdishokohi/flomorphic:latest

# Go module proxy for the entrypoint's plugin build (and any rebuild after a
# changed PLUGINS_REF). Empty lets the container probe the default proxy and fall
# back to a mirror if this network blocks it (proxy.golang.org redirects module
# zips to storage.googleapis.com, which some networks 403 mid-download). Set one
# explicitly to skip the probe:
#   GOPROXY=https://goproxy.cn,direct
GOPROXY=

# ─── Builtin plugin nodes ────────────────────────────────────────────────────

# The llm and mcp nodes (and whatever else lands in the repo). The container
# starts them itself once the API is up, sharing one credential minted on the
# builtin-plugins account. Set to 0 to run the canvas without them.
PLUGINS_ENABLED=1
PLUGINS_REPO=https://github.com/FloMorphic/builtin-plugins.git
PLUGINS_REF=main
# Comma-separated allow-list of plugin folders; empty = all of them.
PLUGINS=
